{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canvas-server",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-22",
  "durable_objects": {
    "bindings": [
      { "name": "TEAM", "class_name": "Team" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Team", "Room"] }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "studio.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-access-application-audience",
    "OWNER_EMAILS": "owner@example.com",
    "SERVER_VERSION": "0.1.0"
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
